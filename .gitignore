.vscode/
*.log
*.tmp
*.bak
Thumbs.db
Desktop.ini
.DS_Store
node_modules/
bin/
obj/

# Claude Code — keep personal config and memories local
.claude/settings.local.json
.claude/memory/

# Saved copies of Rocket's proprietary/licensed docs — keep local, do not publish
webfetched/

# Uniface live install-project runtime artifacts. The repository database and IDE
# state are the LIVE master-of-record / transient UI state — NOT the VCS
# serialization (XML exports are; see uniface-repository-source-of-truth rule).
# install_info.txt is kept tracked as a baseline record of the install.
uniface/project/dbms/
uniface/project/ide_state.zip
uniface/project/resources/
uniface/project/Your Project Folder.txt
# Compiled-module information generated at compile time (not source).
uniface/project/*.cmi
# Project-local IDE assignment file — machine-specific absolute paths and (for the
# WAS WorkArea plugin) enables a non-commercial plugin. Local runtime config, never
# tracked; recreate via the was-project-setup skill. See uniface-export-staging rule.
uniface/project/ide.asn

# Client-confidential handoff/meeting notes & third-party PII — keep LOCAL only,
# never tracked. Purged from history on 2026-06-30 (worklog/016). See
# .claude/rules/protect-secrets-and-proprietary.md.
business/

# Local staging for Uniface IDE/engine export artifacts (NEVER the Claude scratchpad
# or ad-hoc C:\temp). Contents are gitignored; the README is tracked so the folder and
# its contract stay in the repo. See .claude/rules/uniface-export-staging.md.
scratch/*
!scratch/README.md
